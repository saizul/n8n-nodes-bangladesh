{
	"name": "n8n-nodes-bangladesh",
	"version": "0.1.0",
	"description": "n8n community node with Bangladesh-specific utilities: phone validation and operator detection, Bangla number and Taka amount in words, lakh/crore formatting, Bangla calendar dates, Bangla slugs and the 8 divisions / 64 districts.",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-node",
		"bangladesh",
		"bangla",
		"bengali",
		"bd-phone",
		"taka",
		"bangla-calendar"
	],
	"license": "MIT",
	"homepage": "https://github.com/saizul/n8n-nodes-bangladesh#readme",
	"author": {
		"name": "Saizul Amin",
		"url": "https://saizul.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/saizul/n8n-nodes-bangladesh.git"
	},
	"bugs": {
		"url": "https://github.com/saizul/n8n-nodes-bangladesh/issues"
	},
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json && gulp build:icons",
		"clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint nodes test",
		"lint:fix": "eslint nodes test --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "npm run clean && npm run build && npm run lint && npm test"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/BangladeshUtils/BangladeshUtils.node.js"
		]
	},
	"devDependencies": {
		"@eslint/js": "^9.39.0",
		"@types/node": "^22.19.0",
		"eslint": "^9.39.0",
		"eslint-plugin-n8n-nodes-base": "2.0.0",
		"gulp": "5.0.1",
		"n8n-workflow": "2.16.0",
		"prettier": "3.9.10",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.0",
		"vitest": "5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
